**Cell 6 — Feature engineering**

feat = df.copy()
feat["hour_sin"] = np.sin(2*np.pi*feat["HourNum"]/24)
feat["hour_cos"] = np.cos(2*np.pi*feat["HourNum"]/24)
feat["Target"] = feat["Temperature"].shift(-1)

feat["lag1"] = feat["Temperature"].shift(1)
feat["lag2"] = feat["Temperature"].shift(2)
feat["lag3"] = feat["Temperature"].shift(3)
feat["rolling3"] = feat["Temperature"].shift(1).rolling(3).mean()

feat = pd.get_dummies(feat, columns=["Period"], prefix="Period", drop_first=True)
for col in ["Period_Noon", "Period_Evening"]:
    if col not in feat.columns:
        feat[col] = 0

feat = feat.dropna().reset_index(drop=True)

feature_cols = ["Temperature", "Humidity", "RainFlag", "hour_sin", "hour_cos",
                 "lag1", "lag2", "lag3", "rolling3", "Period_Noon", "Period_Evening"]

X = feat[feature_cols]
y = feat["Target"]

print("Usable rows after feature engineering:", X.shape)
