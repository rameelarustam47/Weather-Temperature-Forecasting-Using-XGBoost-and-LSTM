Cell 12 — Build LSTM sequences


LOOKBACK = 6

lstm_features = ["Temperature", "hour_sin", "hour_cos"]
raw = df.copy()
raw["hour_sin"] = np.sin(2*np.pi*raw["HourNum"]/24)
raw["hour_cos"] = np.cos(2*np.pi*raw["HourNum"]/24)
data = raw[lstm_features].values

def make_sequences(data, lookback, target_col=0):
    Xs, ys = [], []
    for i in range(len(data) - lookback):
        Xs.append(data[i:i+lookback])
        ys.append(data[i+lookback, target_col])
    return np.array(Xs), np.array(ys)

X_seq, y_seq = make_sequences(data, LOOKBACK)
print("Sequence X shape:", X_seq.shape, " y shape:", y_seq.shape)

**Cell 13 — Split sequences**

n_seq = len(X_seq)
train_end_seq = int(n_seq * 0.70)
val_end_seq = int(n_seq * 0.85)

X_train_seq, y_train_seq = X_seq[:train_end_seq], y_seq[:train_end_seq]
X_val_seq, y_val_seq = X_seq[train_end_seq:val_end_seq], y_seq[train_end_seq:val_end_seq]
X_test_seq, y_test_seq = X_seq[val_end_seq:], y_seq[val_end_seq:]

print("Train:", X_train_seq.shape, " Val:", X_val_seq.shape, " Test:", X_test_seq.shape)

**Cell 14 — Scale temperature**

temp_scaler = StandardScaler()
temp_scaler.fit(X_train_seq[:, :, 0].reshape(-1, 1))

def scale_temp_channel(X):
    X = X.copy()
    shape = X[:, :, 0].shape
    X[:, :, 0] = temp_scaler.transform(X[:, :, 0].reshape(-1, 1)).reshape(shape)
    return X

X_train_scaled = scale_temp_channel(X_train_seq)
X_val_scaled = scale_temp_channel(X_val_seq)
X_test_scaled = scale_temp_channel(X_test_seq)

y_train_scaled = temp_scaler.transform(y_train_seq.reshape(-1,1))
y_val_scaled = temp_scaler.transform(y_val_seq.reshape(-1,1))
y_test_scaled = temp_scaler.transform(y_test_seq.reshape(-1,1))

**Cell 15 — Build and train LSTM**

lstm_model = Sequential([
    Input(shape=(LOOKBACK, len(lstm_features))),
    LSTM(32),
    Dropout(0.2),
    Dense(1)
])

lstm_model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.001), loss="mse")

early_stop = EarlyStopping(monitor="val_loss", patience=10, restore_best_weights=True)

history = lstm_model.fit(
    X_train_scaled, y_train_scaled,
    validation_data=(X_val_scaled, y_val_scaled),
    epochs=100,
    batch_size=4,
    callbacks=[early_stop],
    verbose=1
)

**Cell 16 — Plot loss curve**

plt.figure(figsize=(9,4))
plt.plot(history.history["loss"], label="Train loss")
plt.plot(history.history["val_loss"], label="Validation loss")
plt.title("LSTM Training — Loss Curve")
plt.xlabel("Epoch")
plt.ylabel("MSE Loss")
plt.legend()
plt.grid(alpha=0.3)
plt.show()

**Cell 17 — Evaluate LSTM**

lstm_pred_scaled = lstm_model.predict(X_test_scaled)
lstm_pred = temp_scaler.inverse_transform(lstm_pred_scaled).flatten()
y_test_actual = y_test_seq.flatten()

lstm_mae = mean_absolute_error(y_test_actual, lstm_pred)
lstm_rmse = np.sqrt(mean_squared_error(y_test_actual, lstm_pred))
lstm_r2 = r2_score(y_test_actual, lstm_pred)

print(f"LSTM  ->  MAE: {lstm_mae:.3f}   RMSE: {lstm_rmse:.3f}   R2: {lstm_r2:.3f}")

